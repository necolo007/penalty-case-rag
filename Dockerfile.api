FROM python:3.11-slim

WORKDIR /app

COPY pyproject.toml README.md ./
COPY core ./core
COPY engine ./engine
COPY pipeline ./pipeline
COPY api ./api
COPY scripts ./scripts
COPY db ./db

# API 镜像默认不装本地模型/MinerU；Reranker 需要时加 local-models
RUN pip install --no-cache-dir -e . && \
    pip install --no-cache-dir -e ".[local-models]" || echo "local-models optional install skipped"

EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
