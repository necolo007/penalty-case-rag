# API 服务镜像（可选整栈部署；日常开发可本机 make api）
# 含 local-models，便于容器内 EMBEDDING_PROVIDER=local_bge_m3
FROM python:3.11-slim

WORKDIR /app

COPY pyproject.toml README.md ./
COPY core ./core
COPY engine ./engine
COPY pipeline ./pipeline
COPY api ./api
COPY scripts ./scripts
COPY db ./db

RUN pip install --no-cache-dir -U pip \
    && pip install --no-cache-dir -e ".[local-models]"

EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
