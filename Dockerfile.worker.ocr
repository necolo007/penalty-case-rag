# OCR Worker：扫描件解析（Linux / WSL Docker）
#
# RapidOCR(ONNX) + pdfplumber：文字版 PDF 走 pdfplumber，扫描件走 RapidOCR。
# 不安装 PaddleOCR / MinerU / torch。
#
# 构建：docker compose build worker
# 启动：docker compose up -d worker

FROM python:3.11-bookworm

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgl1 \
    libfontconfig1 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY core ./core
COPY engine ./engine
COPY pipeline ./pipeline
COPY api ./api
COPY scripts ./scripts
COPY db ./db

RUN pip install --no-cache-dir -U pip setuptools wheel \
    && pip install --no-cache-dir -e . \
    && pip install --no-cache-dir \
        "rapidocr-onnxruntime>=1.3" \
        "onnxruntime>=1.16" \
        "opencv-python-headless>=4.8,<4.11" \
        "pymupdf>=1.24,<1.27"

RUN python -c "from rapidocr_onnxruntime import RapidOCR; print('RapidOCR OK')"
RUN python -c "import fitz; print('pymupdf OK', getattr(fitz, 'version', ('?',))[0])"

CMD ["arq", "pipeline.tasks.ingest.WorkerSettings"]
