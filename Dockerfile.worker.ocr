# Worker：OCR 扫描件解析（Linux/WSL Docker）
#
# 使用 RapidOCR(ONNX)，避免 PaddlePaddle + OpenCV/Torch 同镜像 SIGSEGV。
# 文字版 PDF → pdfplumber；扫描件 / 低置信度 → RapidOCR。
#
# 构建：docker compose build worker
# 启动：docker compose up -d worker

FROM python:3.11-bookworm

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgl1 \
    libfontconfig1 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY core ./core
COPY engine ./engine
COPY pipeline ./pipeline
COPY api ./api
COPY scripts ./scripts
COPY db ./db

# 基础依赖 + RapidOCR（onnxruntime）+ PDF 渲染（pymupdf）
# 不安装 paddleocr / magic-pdf / torch
RUN pip install --no-cache-dir -U pip setuptools wheel \
    && pip install --no-cache-dir -e . \
    && pip install --no-cache-dir \
        "rapidocr-onnxruntime>=1.3" \
        "onnxruntime>=1.16" \
        "opencv-python-headless>=4.8,<4.11" \
        "pymupdf>=1.24,<1.27"

RUN python -c "from rapidocr_onnxruntime import RapidOCR; print('RapidOCR OK')"
RUN python -c "import fitz; print('pymupdf OK', getattr(fitz, 'version', ('?',))[0])"

CMD ["arq", "pipeline.tasks.ingest.WorkerSettings"]
