# 轻量 Worker：无 OCR，文字版 PDF 走 pdfplumber。
# 扫描件请用 Dockerfile.worker.ocr（docker compose up worker）。
FROM python:3.11-slim

WORKDIR /app

COPY pyproject.toml README.md ./
COPY core ./core
COPY engine ./engine
COPY pipeline ./pipeline
COPY api ./api
COPY scripts ./scripts
COPY db ./db

RUN pip install --no-cache-dir -U pip \
    && pip install --no-cache-dir -e .

CMD ["arq", "pipeline.tasks.ingest.WorkerSettings"]
