# 轻量 Worker：无 OCR/MinerU，解析降级为 pdfplumber。
# OCR 能力请用 Dockerfile.worker.ocr（RapidOCR/ONNX）
FROM python:3.11-slim

WORKDIR /app

COPY pyproject.toml README.md ./
COPY core ./core
COPY engine ./engine
COPY pipeline ./pipeline
COPY api ./api
COPY scripts ./scripts
COPY db ./db

# Worker 需要解析栈；OCR 请用 Dockerfile.worker.ocr。可选 MinerU：
RUN pip install --no-cache-dir -e . && \
    pip install --no-cache-dir -e ".[parsing-mineru]" || echo "parsing-mineru skipped (fallback to pdfplumber)"

CMD ["arq", "pipeline.tasks.ingest.WorkerSettings"]
