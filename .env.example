# ============ PostgreSQL ============
PG_PASSWORD=change-me-in-production
# Windows Hyper-V 常保留 5432；宿主机映射见 PG_HOST_PORT（默认 15432）
DATABASE_URL=postgresql://kb_admin:change-me-in-production@localhost:15432/penalty_kb
PG_HOST_PORT=15432
AUTO_MIGRATE=true                       # API/Worker 启动时自动建表（GORM AutoMigrate 风格）
REQUIRE_ZHPARSER=false                  # true=无 zhparser 时启动失败（配合 Dockerfile.postgres）

# ============ Redis ============
REDIS_URL=redis://localhost:6534
REDIS_HOST_PORT=6534

# ============ LLM API（DeepSeek-V4-Flash，官方端点） ============
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_THINKING_DEFAULT=disabled          # disabled | enabled
LLM_TEMPERATURE=0.1
LLM_MAX_RETRIES=3

# ============ Embedding（任务3默认本地 BGE-M3） ============
# local_bge_m3=任务3默认；cloud / local 仅 legacy（cloud 需自行配置兼容网关）
EMBEDDING_PROVIDER=local_bge_m3
EMBEDDING_CACHE_TTL=3600
EMBEDDING_DIMENSIONS=1024
# legacy cloud（可选，默认不用）
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=
# EMBEDDING_MODEL=
# EMBEDDING_FALLBACK=local

# ============ Hugging Face 镜像 ============
# Hub id（BAAI/bge-m3 等）经此镜像拉取；勿直连 huggingface.co
HF_ENDPOINT=https://hf-mirror.com

# ============ Embedding（legacy 本地兜底） ============
EMBEDDING_MODEL_LOCAL=BAAI/bge-large-zh-v1.5
EMBEDDING_DEVICE=cpu

# ============ BGE-M3 ============
BGE_M3_MODEL=BAAI/bge-m3
BGE_M3_DEVICE=cpu
BGE_M3_BATCH_SIZE=4
BGE_M3_MAX_LENGTH=8192

# ============ Reranker ============
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANKER_ENABLED=true
RERANKER_BATCH_SIZE=8
RERANKER_DOC_MAX_CHARS=1200

# ============ 检索后端 ============
RETRIEVAL_BACKEND=bge_m3
# HyDE：假想违法事实 dense 通道（需 LLM_API_KEY；无 Key 时自动跳过）
RETRIEVAL_HYDE_ENABLED=true
# HyDE 文本参与 CE：与口语 query 双路打分取 max（评测显示劣化，默认关）
RETRIEVAL_HYDE_RERANK=false
# 融合：max_merge（默认）| weighted_rrf（原文/改写加权 RRF，建议 raw+rewrite=1）
RETRIEVAL_FUSION_MODE=max_merge
# CE 后 LLM 列表重排+减枝（抬 Judge 精确率；默认关）
RETRIEVAL_LLM_LISTWISE=true
RETRIEVAL_LLM_LISTWISE_KEEP_MIN=3
RETRIEVAL_LLM_LISTWISE_KEEP_MAX=10
RECALL_DENSE=200
RRF_W_DENSE_HYDE=0.35
RECALL_SPARSE=100
RETRIEVAL_FUSION_SIZE=200
RETRIEVAL_RERANK_CANDIDATES=200
# weighted_rrf：建议 dense_raw + dense = 1（如 0.4/0.6）
RRF_W_DENSE=0.6
RRF_W_DENSE_RAW=0.4
RRF_W_SPARSE=0.2
RRF_MULTI_CHANNEL_BONUS=0.05

# legacy 四路（仅 RETRIEVAL_BACKEND=legacy_four_way）
RECALL_BM25=80
RECALL_VECTOR=100
RECALL_TAG=80
RECALL_RULE=30
RRF_K=60
RRF_W_BM25=1.15
RRF_W_VECTOR=1.45
RRF_W_TAG=1.0
RRF_W_RULE=1.2
CN_TAG_PREDICT_MAX=3
CN_TAG_FINAL_MAX=5
CN_TAG_CASE_MAX=12
CN_TAG_BM25_APPEND=2
RISK_ID_CAP=3
TAG_BACKFILL_TOP_CASES=5

# ============ 抽取 / 解析阈值 ============
# llm_first=长文提示词主抽（默认）；regex_first=正则主抽+低置信度纠错
EXTRACTION_MODE=llm_first
EXTRACTION_LLM_MAX_CHARS=8000
LLM_REFINE_THRESHOLD=0.6
PARSE_CONFIDENCE_THRESHOLD=0.5

# ============ MinerU ============
MINERU_ENGINE=hybrid                  # pipeline | vlm | hybrid

# ============ Storage ============
UPLOAD_DIR=./uploads
DATA_DIR=./data
MAX_UPLOAD_SIZE_MB=50

# ============ 竞赛配套数据（可选） ============
# 默认自动探测仓库 docs/data/05-.../配套数据
# COMP_DATA_DIR=D:/code/Drafter/docs/data/05-金融大模型与智能体赛道-基于知识增强检索的保险监管处罚案例知识库构建与合规审查智能匹配/配套数据
# COMP_RAW_TEXT_DIR=D:/code/Drafter/docs/data/05-金融大模型与智能体赛道-基于知识增强检索的保险监管处罚案例知识库构建与合规审查智能匹配/raw_text
# 监管处罚原文语料（抽样测试集 / 批量入库源，默认自动探测 ../docs/example）
# EXAMPLE_CORPUS_DIR=D:/code/Drafter/docs/example
# submission.risk_type：cn=中文标签（默认）| competition=R00x 长描述
SUBMISSION_RISK_STYLE=cn
