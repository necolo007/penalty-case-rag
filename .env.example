# ============ PostgreSQL ============
PG_PASSWORD=change-me-in-production
DATABASE_URL=postgresql://kb_admin:change-me-in-production@localhost:5432/penalty_kb
AUTO_MIGRATE=true                       # API/Worker 启动时自动建表（GORM AutoMigrate 风格）
REQUIRE_ZHPARSER=false                  # true=无 zhparser 时启动失败（配合 Dockerfile.postgres）

# ============ Redis ============
REDIS_URL=redis://localhost:6379

# ============ LLM API（DeepSeek-V4-Flash，官方端点） ============
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_THINKING_DEFAULT=disabled          # disabled | enabled
LLM_TEMPERATURE=0.1
LLM_MAX_RETRIES=3

# ============ Embedding API（Qwen，第三方网关，与 LLM 独立配置） ============
EMBEDDING_PROVIDER=cloud              # cloud | local
EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxx
EMBEDDING_BASE_URL=https://tokendance.space/gateway/v1
EMBEDDING_MODEL=qwen-text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_INSTRUCT="Given an insurance marketing claim, retrieve similar regulatory penalty cases"
EMBEDDING_FALLBACK=local              # API 失败时自动降级本地模型
EMBEDDING_CACHE_TTL=3600              # query 向量 Redis 缓存秒数

# ============ Embedding（本地） ============
EMBEDDING_MODEL_LOCAL=BAAI/bge-large-zh-v1.5
EMBEDDING_DEVICE=cuda                 # cuda | cpu

# ============ Reranker（本地推理） ============
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cuda                  # cuda | cpu
RERANKER_ENABLED=true

# ============ MinerU ============
MINERU_ENGINE=hybrid                  # pipeline | vlm | hybrid

# ============ Storage ============
UPLOAD_DIR=./uploads
DATA_DIR=./data
MAX_UPLOAD_SIZE_MB=50
