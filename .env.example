# ============ PostgreSQL / Redis ============
PG_PASSWORD=change-me-in-production
# Ubuntu 标准环境可用 5432/6379；若冲突再改 PORT
DATABASE_URL=postgresql://kb_admin:change-me-in-production@localhost:5432/penalty_kb
PG_HOST_PORT=5432
REDIS_URL=redis://localhost:6379
REDIS_HOST_PORT=6379
AUTO_MIGRATE=true

# ============ LLM（第三方 API，国内可达；非本地权重） ============
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_THINKING_DEFAULT=disabled
LLM_TEMPERATURE=0.1
LLM_MAX_RETRIES=3

# ============ 本地模型权重（随工程提交，禁止现场从 Hub 下载） ============
EMBEDDING_PROVIDER=local_bge_m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_CACHE_TTL=3600
# 离线加载：指向已解压的完整权重目录
BGE_M3_MODEL=../models/bge-m3
BGE_M3_DEVICE=cuda
BGE_M3_BATCH_SIZE=8
BGE_M3_MAX_LENGTH=8192
RERANKER_MODEL=../models/bge-reranker-v2-m3
RERANKER_DEVICE=cuda
RERANKER_ENABLED=true
RERANKER_BATCH_SIZE=16
RERANKER_DOC_MAX_CHARS=1200
# 禁止运行时访问 huggingface.co（须写入进程环境，代码会同步到 os.environ）
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
# 部署现场请留空；仅打包机执行 prepare_models.py 时可设：
# HF_ENDPOINT=https://hf-mirror.com
# HF_HUB_OFFLINE=0

# ============ 检索（bge_m3） ============
RETRIEVAL_BACKEND=bge_m3
RETRIEVAL_HYDE_ENABLED=true
RETRIEVAL_DENSE_RAW_ENABLED=true
RETRIEVAL_LLM_LISTWISE=true
RETRIEVAL_LLM_LISTWISE_KEEP_MIN=3
RETRIEVAL_LLM_LISTWISE_KEEP_MAX=10
RECALL_DENSE=200
RECALL_SPARSE=100
RETRIEVAL_FUSION_SIZE=200
RETRIEVAL_RERANK_CANDIDATES=200
CN_TAG_PREDICT_MAX=3
CN_TAG_FINAL_MAX=5
CN_TAG_CASE_MAX=12
RISK_ID_CAP=3
TAG_BACKFILL_TOP_CASES=5

# ============ 抽取 / 存储 ============
EXTRACTION_MODE=llm_first
EXTRACTION_LLM_MAX_CHARS=8000
UPLOAD_DIR=./uploads
DATA_DIR=./data
MAX_UPLOAD_SIZE_MB=50
SUBMISSION_RISK_STYLE=cn
