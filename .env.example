# ============ PostgreSQL / Redis ============
PG_PASSWORD=change-me-in-production
# Windows Hyper-V 常占用 5432/6379；宿主机映射见下方 PORT
DATABASE_URL=postgresql://kb_admin:change-me-in-production@localhost:15432/penalty_kb
PG_HOST_PORT=15432
REDIS_URL=redis://localhost:6534
REDIS_HOST_PORT=6534
AUTO_MIGRATE=true

# ============ LLM（DeepSeek-V4-Flash） ============
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_THINKING_DEFAULT=disabled
LLM_TEMPERATURE=0.1
LLM_MAX_RETRIES=3

# ============ Embedding / 本地模型（任务3 默认 BGE-M3） ============
EMBEDDING_PROVIDER=local_bge_m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_CACHE_TTL=3600
# Hub 权重经镜像拉取（勿直连 huggingface.co）
HF_ENDPOINT=https://hf-mirror.com
BGE_M3_MODEL=BAAI/bge-m3
BGE_M3_DEVICE=cpu
BGE_M3_BATCH_SIZE=4
BGE_M3_MAX_LENGTH=8192
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANKER_ENABLED=true
RERANKER_BATCH_SIZE=8
RERANKER_DOC_MAX_CHARS=1200

# ============ 检索（bge_m3） ============
RETRIEVAL_BACKEND=bge_m3
RETRIEVAL_HYDE_ENABLED=true
RETRIEVAL_DENSE_RAW_ENABLED=true
RETRIEVAL_LLM_LISTWISE=true
RETRIEVAL_LLM_LISTWISE_KEEP_MIN=3
RETRIEVAL_LLM_LISTWISE_KEEP_MAX=10
RECALL_DENSE=200
RECALL_SPARSE=100
RETRIEVAL_FUSION_SIZE=200
RETRIEVAL_RERANK_CANDIDATES=200
CN_TAG_PREDICT_MAX=3
CN_TAG_FINAL_MAX=5
CN_TAG_CASE_MAX=12
RISK_ID_CAP=3
TAG_BACKFILL_TOP_CASES=5

# ============ 任务2 few-shot ============
# 默认多标签库；缺失则不注入 few-shot。勿用评测金标切 train 建库。
FEWSHOT_ENABLED=true
FEWSHOT_BANK_PATH=data/fewshot/risk_tag_fewshot_bank_multilabel.jsonl
FEWSHOT_RETRIEVER=lexical
FEWSHOT_TOP_N=3
FEWSHOT_REQUIRE_COVERED_HINT=true

# ============ 抽取 / 存储 ============
# llm_first=长字段 LLM 主抽；regex_first=正则主抽
EXTRACTION_MODE=llm_first
EXTRACTION_LLM_MAX_CHARS=8000
UPLOAD_DIR=./uploads
DATA_DIR=./data
MAX_UPLOAD_SIZE_MB=50
